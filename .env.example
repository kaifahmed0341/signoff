# Copy to .env.local. Every value is optional: with none set, Signoff runs on
# the built-in test rail and the scripted checker so you can try the full loop.

# Where the app is served. Used for client links and to let the checker read
# the built-in sample deliverables.
APP_URL=http://localhost:3000

# Operator console passcode and the secret that signs sessions, share links and
# acceptance records. Change both for any real use.
OPERATOR_PASSCODE=signoff-demo
SESSION_SECRET=change-me-to-a-long-random-string

# Local SQLite file by default. A hosted libSQL database also works.
DATABASE_URL=file:./data/signoff.db
# DATABASE_AUTH_TOKEN=

# Braintree, a PayPal service. Sandbox keys come from
# https://sandbox.braintreegateway.com > Settings > API. With all three set the
# app uses the sandbox; without them it uses the built-in test rail.
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
# BRAINTREE_MERCHANT_ACCOUNT_ID=
# BRAINTREE_ENVIRONMENT=sandbox
CURRENCY=USD

# AI. Google Gemini is the default provider; Anthropic is the alternative.
# With no key the app uses a scripted checker and says so on every report.
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_MODEL=gemini-3.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# AI_PROVIDER=auto

# Optional: raises GitHub API limits when the checker reads a repository.
# GITHUB_TOKEN=
